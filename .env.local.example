# Copy this file to .env.local and fill in real values from
# Supabase Dashboard > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Never prefix with NEXT_PUBLIC_. Used only in server actions /
# route handlers that need elevated privileges (e.g. admin-only writes that
# bypass RLS). Do not import this in any client component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
